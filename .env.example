# Copy to .env and replace with your own PostgreSQL connection details.
DATABASE_URL=postgresql://story_sprout_user:replace_me@localhost:5432/story_sprout
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
OWNER_EMAIL=owner@example.com
TRUST_PROXY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
STORY_GEN_RATE_LIMIT=30
AI_MONTHLY_INVOCATION_LIMIT=100
OPENAI_API_KEY=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Story Sprout <no-reply@yourdomain.com>
OPENAI_ENABLE_MODERATION=true
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Optional: Stripe billing (leave blank to keep demo billing only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY_500=
STRIPE_PRICE_FAMILY_800=
STRIPE_PRICE_FAMILY_1200=
STRIPE_PRICE_CLASSROOM_1800=
